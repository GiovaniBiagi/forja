{
  "name": "@forjakit/auth-fastify",
  "version": "0.2.0",
  "description": "Fastify plugin that exposes `@forjakit/auth` as a REST API. Registers auth routes with tenant isolation, input validation, rate limiting, optional cookie-based token delivery, and structured error responses. Also provides standalone middleware factories f",
  "license": "MIT",
  "author": "Giovani de Biagi Alves <giovani@giovanialves.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GiovaniBiagi/forja.git",
    "directory": "packages/auth-fastify"
  },
  "homepage": "https://github.com/GiovaniBiagi/forja/tree/main/packages/auth-fastify#readme",
  "bugs": {
    "url": "https://github.com/GiovaniBiagi/forja/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@fastify/cookie": "^11.0.0",
    "@forjakit/auth": "^0.2.0",
    "fastify": "^5.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@fastify/cookie": "^11.1.2",
    "@forjakit/auth": "workspace:*",
    "fastify": "^5.12.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "publishConfig": {
    "access": "public"
  }
}
