{
  "name": "@forjakit/scheduling-fastify",
  "version": "0.2.0",
  "description": "Fastify plugin that exposes `@forjakit/scheduling` as a REST API. Registers CRUD routes for scheduled events with tenant isolation, input validation, auth guard hooks, and structured error responses.",
  "license": "MIT",
  "author": "Giovani de Biagi Alves <giovani@giovanialves.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GiovaniBiagi/forja.git",
    "directory": "packages/scheduling-fastify"
  },
  "homepage": "https://github.com/GiovaniBiagi/forja/tree/main/packages/scheduling-fastify#readme",
  "bugs": {
    "url": "https://github.com/GiovaniBiagi/forja/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@forjakit/scheduling": "^0.2.0",
    "fastify": "^5.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@forjakit/scheduling": "workspace:*",
    "fastify": "^5.12.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "publishConfig": {
    "access": "public"
  }
}
