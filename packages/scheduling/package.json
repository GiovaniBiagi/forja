  "license": "MIT",
  "author": "Giovani de Biagi Alves <giovani@giovanialves.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GiovaniBiagi/forja.git",
    "directory": "packages/scheduling"
  },
  "homepage": "https://github.com/GiovaniBiagi/forja/tree/main/packages/scheduling#readme",
  "bugs": {
    "url": "https://github.com/GiovaniBiagi/forja/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch"
  },
  "dependencies": {
