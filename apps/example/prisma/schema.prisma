generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(uuid())
  email        String
  name         String
  role         String
  tenantId     String
  passwordHash String
  createdAt    DateTime @default(now())

  @@unique([email, tenantId])
}
